/*
 * K. pneumoniae Phylogenomics Pipeline
 * nextflow.config
 */

params {
    input         = System.getenv('HOME') + '/projects/K_pneumoniae-phylogenomics/data/selected/*.fna'
    reference     = System.getenv('HOME') + '/projects/K_pneumoniae-phylogenomics/data/metadata/reference.fasta'
    outdir        = System.getenv('HOME') + '/projects/K_pneumoniae-phylogenomics/results'
    threads       = 8
    snp_threshold = 25
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    cpus   = 4
    memory = '8 GB'
    time   = '2h'
    withName: 'QUAST'      { container = 'quay.io/biocontainers/quast:5.2.0--py39pl5321h2add14b_1'; cpus = 4; memory = '4 GB' }
    withName: 'PROKKA'     { container = 'quay.io/biocontainers/prokka:1.14.6--pl5321hdfd78af_5';   cpus = 8; memory = '8 GB' }
    withName: 'MLST'       { container = 'quay.io/biocontainers/mlst:2.23.0--hdfd78af_0';           cpus = 2; memory = '2 GB' }
    withName: 'KLEBORATE'  { container = 'quay.io/biocontainers/kleborate:3.2.4--pyhdfd78af_0';     cpus = 4; memory = '4 GB' }
    withName: 'AMRFINDER'  { container = 'ncbi/amr:latest';                                         cpus = 4; memory = '4 GB' }
    withName: 'SNIPPY'     { container = 'quay.io/biocontainers/snippy:4.6.0--hdfd78af_4';          cpus = 8; memory = '8 GB' }
    withName: 'SNIPPY_CORE'{ container = 'quay.io/biocontainers/snippy:4.6.0--hdfd78af_4'; cpus = 4; memory = '12 GB' }
    withName: 'GUBBINS' { container = 'staphb/gubbins:3.3.5'; cpus = 8; memory = '12 GB'; time = '6h' }
    withName: 'IQTREE' { container = 'staphb/iqtree2:2.3.6'; cpus = 8; memory = '12 GB'; time = '4h' }
    withName: 'SNP_DISTS'  { container = 'staphb/snp-dists:0.8.2'; cpus = 2; memory = '4 GB' }
}

report   { enabled = true; file = System.getenv('HOME') + '/projects/K_pneumoniae-phylogenomics/results/pipeline_report.html';   overwrite = true }
timeline { enabled = true; file = System.getenv('HOME') + '/projects/K_pneumoniae-phylogenomics/results/pipeline_timeline.html'; overwrite = true }
